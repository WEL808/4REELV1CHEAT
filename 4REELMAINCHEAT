        local function removeESP(player)
            if lines[player] then
                lines[player]:Destroy()
                lines[player] = nil
            end
            if tags[player] then
                tags[player]:Destroy()
                tags[player] = nil
            end
        end

        local function createESP(player)
            if player == LP then return end

            local function setup()
                removeESP(player)
                local char = player.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head")
                if not hrp or not head then return end

                local line = Instance.new("Part")
                line.Name = "ESP_LINE"
                line.Anchored = true
                line.CanCollide = false
                line.Material = Enum.Material.Neon
                line.Color = Color3.fromRGB(255,255,255)
                line.Size = Vector3.new(0.12,0.12,1)
                line.Parent = workspace
                lines[player] = line

                local bill = Instance.new("BillboardGui")
                bill.Name = "ESP_TAG"
                bill.Size = UDim2.new(0,120,0,35)
                bill.StudsOffset = Vector3.new(0,2.5,0)
                bill.AlwaysOnTop = true
                bill.Adornee = head

                local txt = Instance.new("TextLabel")
                txt.Parent = bill
                txt.Size = UDim2.new(1,0,1,0)
                txt.BackgroundTransparency = 1
                txt.Text = player.DisplayName .. "\n(@" .. player.Name .. ")"
                txt.TextColor3 = Color3.fromRGB(255,255,255)
                txt.TextStrokeTransparency = 0
                txt.Font = Enum.Font.GothamBold
                txt.TextScaled = true
                bill.Parent = head
                tags[player] = bill
            end

            if player.Character then
                setup()
            end
            local conn = player.CharacterAdded:Connect(function()
                task.wait(1)
                setup()
            end)
            table.insert(connections, conn)
        end

        local function updateESP()
            local myChar = LP.Character
            if not myChar then return end
            local myRoot = myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end

            for player, line in pairs(lines) do
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root and root:IsDescendantOf(workspace) then
                    local distance = (root.Position - myRoot.Position).Magnitude
                    line.Size = Vector3.new(0.12,0.12,distance)
                    line.CFrame = CFrame.new(myRoot.Position, root.Position) * CFrame.new(0,0,-distance/2)
                else
                    removeESP(player)
                end
            end
        end

        local function clearESP()
            for _,v in pairs(lines) do
                v:Destroy()
            end
            for _,v in pairs(tags) do
                v:Destroy()
            end
            for _,v in ipairs(connections) do
                v:Disconnect()
            end
            lines = {}
            tags = {}
            connections = {}
            if renderConnection then
                renderConnection:Disconnect()
                renderConnection = nil
            end
        end

        local function toggleESP()
            enabled = not enabled
            if enabled then
                trackButton.Text = "TRACK : ON"
                trackButton.TextColor3 = Color3.fromRGB(120,255,120)
                for _,player in ipairs(Players:GetPlayers()) do
                    createESP(player)
                end
                local addConn = Players.PlayerAdded:Connect(function(plr)
                    createESP(plr)
                end)
                table.insert(connections, addConn)
                renderConnection = RunService.RenderStepped:Connect(updateESP)
            else
                trackButton.Text = "TRACK : OFF"
                trackButton.TextColor3 = Color3.fromRGB(255,70,70)
                clearESP()
            end
        end

        trackButton.MouseButton1Click:Connect(function()
            toggleESP()
        end)

