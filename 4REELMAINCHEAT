local function getAllDirtyPiles()
    local piles = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and not cleanedPiles[obj] then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") then
                table.insert(piles, {object = obj, position = parent.Position})
            end
        end
        if obj:IsA("BasePart") and not cleanedPiles[obj] then
            local objName = obj.Name:lower()
            if objName:find("dirt") or objName:find("trash") or objName:find("mess") or objName:find("garbage") then
                table.insert(piles, {object = obj, position = obj.Position})
            end
        end
    end
    return piles
end

local function getNearestDirtyPile()
    local target = nil
    local closestDist = math.huge
    local targetPos = nil
    local allPiles = getAllDirtyPiles()
    for _, pile in pairs(allPiles) do
        local distance = (rootPart.Position - pile.position).Magnitude
        if distance < closestDist then
            closestDist = distance
            target = pile.object
            targetPos = pile.position
        end
    end
    return target, closestDist, targetPos
end

local function interactWithPile(pile)
    isCleaning = true
    if AUTO_SPRINT then
        VIM:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
        task.wait(0.1)
    end
    local success = false
    if pile:IsA("ProximityPrompt") and fireproximityprompt then
        fireproximityprompt(pile)
        success = true
    else
        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(HOLD_DURATION)
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        success = true
    end
    if success then
        cleanedPiles[pile] = true
        local count = 0
        for _ in pairs(cleanedPiles) do count = count + 1 end
        CounterLabel.Text = "Cleaned: " .. count .. " piles"
        task.delay(IGNORE_TIME, function()
            cleanedPiles[pile] = nil
            local newCount = 0
            for _ in pairs(cleanedPiles) do newCount = newCount + 1 end
            CounterLabel.Text = "Cleaned: " .. newCount .. " piles"
        end)
    end
    isCleaning = false
    if AUTO_SPRINT then
        task.wait(0.2)
        VIM:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
    end
end

local function moveToPosition(position)
    if AUTO_SPRINT then
        VIM:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
    end
    humanoid:MoveTo(position)
    task.wait(0.1)
    local path = game:GetService("PathfindingService"):CreatePath()
    local success, errorMsg = pcall(function()
        path:ComputeAsync(rootPart.Position, position)
    end)
    if success and path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        for _, waypoint in ipairs(waypoints) do
            humanoid:MoveTo(waypoint.Position)
            humanoid.MoveToFinished:Wait()
        end
    end
end

local function autoCleanAll()
    if AUTO_SPRINT then
        enableAutoSprint()
        SprintStatus.Text = "Sprint: ACTIVE"
        SprintStatus.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    while autoCleanEnabled do
        if isCleaning then
            task.wait()
        end
        local remainingPiles = getAllDirtyPiles()
        if #remainingPiles == 0 then
            StatusLabel.Text = "Status: COMPLETE!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            autoCleanEnabled = false
            break
        end
        local targetPile, distance, targetPos = getNearestDirtyPile()
        if targetPile and targetPos then
            if distance > INTERACT_RANGE then
                moveToPosition(targetPos)
            else
                moveToPosition(rootPart.Position)
                task.wait(0.2)
                interactWithPile(targetPile)
                task.wait(0.5)
            end
        else
            task.wait(1)
        end
    end
    if AUTO_SPRINT then
        disableAutoSprint()
        SprintStatus.Text = "Sprint: Ready"
        SprintStatus.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

