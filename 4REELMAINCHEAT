local function CreateSlider(parent, yPos, title, minVal, maxVal, defaultVal, callback)
	local Container = Instance.new("Frame")
	Container.Size = UDim2.new(1, -40, 0, 85)
	Container.Position = UDim2.new(0, 20, 0, yPos)
