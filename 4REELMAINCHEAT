	local Track = Instance.new("Frame")
	Track.Size = UDim2.new(1, 0, 0, 8)
	Track.Position = UDim2.new(0, 0, 0, 52)
	Track.BackgroundColor3 = Color3.fromRGB(34, 34, 34)
	Track.BorderSizePixel = 0
	Track.Parent = Container

	local TrackCorner = Instance.new("UICorner")
	TrackCorner.CornerRadius = UDim.new(0, 4)
	TrackCorner.Parent = Track

	local Fill = Instance.new("Frame")
	Fill.Size = UDim2.new(0, 0, 1, 0)
	Fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Fill.BorderSizePixel = 0
	Fill.Parent = Track

	local FillCorner = Instance.new("UICorner")
	FillCorner.CornerRadius = UDim.new(0, 4)
	FillCorner.Parent = Fill

	local KnobSize = 18

	local Knob = Instance.new("ImageButton")
	Knob.Size = UDim2.new(0, KnobSize, 0, KnobSize)
	Knob.Position = UDim2.new(0, -KnobSize / 2, 0.5, -KnobSize / 2)
	Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Knob.BorderSizePixel = 0
	Knob.AutoButtonColor = false
	Knob.Parent = Track

	local KnobCorner = Instance.new("UICorner")
	KnobCorner.CornerRadius = UDim.new(1, 0)
	KnobCorner.Parent = Knob
	
	local KnobStroke = Instance.new("UIStroke")
	KnobStroke.Thickness = 2
	KnobStroke.Color = Color3.fromRGB(0, 0, 0)
	KnobStroke.Parent = Knob

	local currentValue = defaultVal
	local dragging = false

	local function updateSliderFromValue(value)
		local percent = (value - minVal) / (maxVal - minVal)
		local trackWidth = Track.AbsoluteSize.X

		if trackWidth > 0 then
			local fillWidth = trackWidth * percent
			Fill.Size = UDim2.new(0, fillWidth, 1, 0)
			Knob.Position = UDim2.new(percent, -KnobSize / 2, 0.5, -KnobSize / 2)
		end

		if title == "HEAD SIZE" then
			ValueLabel.Text = string.format("%.1f", value)
		else
			ValueLabel.Text = string.format("%.2f", value)
		end
	end

	local function onInput(input)
		local trackWidth = Track.AbsoluteSize.X
		if trackWidth == 0 then return end

		local mouseX = input.Position.X
		local trackLeftX = Track.AbsolutePosition.X
		local relativeX = math.clamp(mouseX - trackLeftX, 0, trackWidth)
		local percent = relativeX / trackWidth

		local rawValue = minVal + (percent * (maxVal - minVal))
		
		local roundedValue
		if title == "HEAD SIZE" then
			roundedValue = math.floor(rawValue * 10 + 0.5) / 10
		else
			roundedValue = math.floor(rawValue * 100 + 0.5) / 100
		end

		roundedValue = math.clamp(roundedValue, minVal, maxVal)
		currentValue = roundedValue
		updateSliderFromValue(currentValue)
		callback(currentValue)
	end

	Knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			onInput(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			onInput(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			onInput(input)
		end
	end)

	updateSliderFromValue(defaultVal)
end

local function applyBigHead(size, transparency)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local head = player.Character:FindFirstChild("Head")
			if head then
				if not originalHeadSizes[head] then
					originalHeadSizes[head] = head.Size
					originalHeadColors[head] = head.Color
					originalHeadMaterials[head] = head.Material
					originalCanCollide[head] = head.CanCollide
				end
				
				head.Size = Vector3.new(size, size, size)
				head.Transparency = transparency
				head.CanCollide = false
				head.Massless = true
				
				local mesh = head:FindFirstChildOfClass("SpecialMesh")
				if mesh then
					mesh.Scale = Vector3.new(1, 1, 1)
				end
			end
		end
	end
end

local function resetAllHeads()
	for head, originalSize in pairs(originalHeadSizes) do
		if head and head.Parent then
			head.Size = originalSize
			if originalHeadColors[head] then
				head.Color = originalHeadColors[head]
			end
			if originalHeadMaterials[head] then
				head.Material = originalHeadMaterials[head]
			end
			if originalCanCollide[head] ~= nil then
				head.CanCollide = originalCanCollide[head]
			end
			head.Transparency = 0
			head.Massless = false
			
			local mesh = head:FindFirstChildOfClass("SpecialMesh")
			if mesh then
				mesh.Scale = Vector3.new(1, 1, 1)
			end
		end
	end
end

